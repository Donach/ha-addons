#!/usr/bin/with-contenv bashio

cd /data || exit

if [ ! -f /data/bma-daemon ]; then
    bashio::log.error "bma-daemon binary not found in /data/"
    exit 1
fi

# Get the logging level from config or use "info" as default if missing
LOG_LEVEL=$(bashio::config 'logging.level' 'info')
export RUST_LOG="${LOG_LEVEL}"
exec /data/bma-daemon